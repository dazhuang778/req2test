# testgen 配置文件
# 复制此文件为 config.yaml 并填入实际值
# 建议将 config.yaml 加入 .gitignore 避免泄露 API Key

# LLM API 密钥（必填）
# 也可通过环境变量 TESTGEN_API_KEY 覆盖此字段
api_key: "sk-your-api-key-here"

# 模型名称（必填）
# 示例：gpt-4o / gpt-4-turbo / claude-3-5-sonnet-20241022 / qwen-max
model: "gpt-4o"

# API 基础 URL（必填）
# OpenAI 官方：https://api.openai.com/v1
# 其他兼容接口：按供应商文档填写
base_url: "https://api.openai.com/v1"

# 以下为可选字段，不填则使用默认值

# LLM 温度参数，控制输出随机性（默认 0.2，范围 0.0-1.0）
# temperature: 0.2

# LLM 输出校验失败时的最大重试次数（默认 3）
# max_retries: 3

# 单次 LLM 请求超时秒数（默认 60）
# timeout: 60
